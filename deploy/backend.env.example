# Production backend settings — copy to /opt/gatherspace/backend.env on the
# server and fill in. NEVER commit the real file. One KEY=value per line,
# no quotes, no spaces around "=" (backup.sh reads it line by line).

# MongoDB Atlas (Database > Connect > Drivers). Include the DB name in DB_NAME.
# Format: mongodb+srv://<user>:<password>@<cluster-host>/?appName=<name>
# Set it on the server with: /opt/gatherspace/set-secret.sh MONGO_URL
MONGO_URL=
DB_NAME=gatherspace

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Razorpay LIVE keys + webhook secret (Settings > API Keys / Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# 0 = online payments "coming soon": pay at venue only, organizer publish fee
# waived, free 24h boost only. Set 1 once the live Razorpay account works.
PAYMENTS_ENABLED=0

# Google Places + Geocoding (server key)
GOOGLE_MAPS_API_KEY=

# S3 for event images and database backups
S3_BUCKET=gatherspace-prod-media
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Decided 2026-10-10: no admin approval step at launch.
EVENT_VERIFICATION_ENABLED=false
MSG91_MOCK_MODE=1
DISABLE_RATE_LIMIT=0
CORS_ORIGINS=https://gatherspace.in,https://www.gatherspace.in
