# Caddy terminates HTTPS (free Let's Encrypt certificates, renewed
# automatically) and forwards to the FastAPI container.
{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode zstd gzip

	# Event cover uploads arrive as base64 JSON (max 3 MB image ≈ 4 MB JSON).
	request_body {
		max_size 10MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	reverse_proxy backend:8001 {
		health_uri /api/health
		health_interval 30s
	}

	log {
		output stdout
		format console
	}
}
