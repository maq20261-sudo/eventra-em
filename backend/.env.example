# Copy to backend/.env and fill in. Never commit the real .env.

APP_ENV=development              # "production" on AWS (enforces JWT secret)
MONGO_URL=mongodb://mongo:27017  # overridden by docker-compose locally; Atlas URI in prod
DB_NAME=gatherspace

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Razorpay — keys from https://dashboard.razorpay.com (Settings > API Keys).
# Leave unset (or blank) to run with "pay at venue" only.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx
# Webhook secret (Settings > Webhooks, event payment.captured →
# https://api.gatherspace.in/api/payments/webhook). Unset = webhook disabled.
# RAZORPAY_WEBHOOK_SECRET=

# Legacy signup/OTP endpoints that skip phone verification. Default: on in
# development (tests use them), off when APP_ENV=production.
# ENABLE_LEGACY_AUTH=1

# Event cover images on S3. Unset S3_BUCKET = images stay inside MongoDB.
# S3_BUCKET=gatherspace-prod-media
# S3_REGION=ap-south-1
# S3_PUBLIC_BASE_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Google Places/Geocoding (server-side key). Blank disables location search.
GOOGLE_MAPS_API_KEY=

# Firebase Admin service account JSON (Firebase Console > Project settings >
# Service accounts > Generate new private key). Default path below.
FIREBASE_ADMIN_JSON_PATH=credentials/firebase-admin.json

# Legacy MSG91 SMS OTP (unused by the current app). 1 = print OTPs to logs.
MSG91_MOCK_MODE=1

# Event verification workflow (admin approves events before they go live).
EVENT_VERIFICATION_ENABLED=false

# Behind Caddy/ALB in production set to 1 so rate limits see real client IPs.
TRUST_X_FORWARDED_FOR=0
DISABLE_RATE_LIMIT=0

# Comma-separated extra CORS origins (web build only; native apps ignore CORS).
CORS_ORIGINS=

# Platform fees (paise) and free tiers — defaults shown.
# PLATFORM_FEE_ATTENDEE_PAISE=900
# PLATFORM_FEE_ORGANIZER_PAISE=1900
# ATTENDEE_FREE_BOOKING_LIMIT=5
# ORGANIZER_FREE_EVENT_LIMIT=5
# CANCEL_CUTOFF_HOURS=2
