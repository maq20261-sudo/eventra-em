{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.discoverbookevents.kb2hgl",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Find events happening near you",
        "NSCameraUsageDescription": "Scan ticket QR codes at your event entrance",
        "NSPhotoLibraryUsageDescription": "Upload a cover image for your event"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.discoverbookevents.kb2hgl",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan ticket QR codes at your event entrance"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Upload a cover image for your event"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
